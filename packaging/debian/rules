#!/usr/bin/make -f
%:
	dh $@

# The project root contains a developer Makefile (all: test).
# Without these no-op overrides debhelper would auto-detect it and run
# "make" (= "make test" = pytest) inside the build chroot, where pytest
# is not installed, breaking the build.
override_dh_auto_configure:
override_dh_auto_build:
override_dh_auto_test:

override_dh_auto_install:
	# DEB_PYTHON_INSTALL_LAYOUT=deb_system: install to /usr/lib/python3/dist-packages/
	#   rather than /usr/local/lib/... (Ubuntu pip default).
	# --no-deps: runtime deps are handled via Depends: in debian/control.
	DEB_PYTHON_INSTALL_LAYOUT=deb_system \
	python3 -m pip install \
	    --no-deps \
	    --root=$(CURDIR)/debian/snxui \
	    --prefix=/usr \
	    --no-compile \
	    .
	# Установить polkit policy
	install -Dm644 snxui/data/com.snxui.policy \
	    $(CURDIR)/debian/snxui/usr/share/polkit-1/actions/com.snxui.policy
	# Установить .desktop файл
	install -Dm644 snxui/data/snxui.desktop \
	    $(CURDIR)/debian/snxui/usr/share/applications/snxui.desktop
	# Установить иконки
	install -Dm644 snxui/data/icons/snxui.svg \
	    $(CURDIR)/debian/snxui/usr/share/icons/hicolor/scalable/apps/snxui.svg
