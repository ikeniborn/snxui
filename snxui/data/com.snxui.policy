<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
  "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
  "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>SNX UI</vendor>
  <vendor_url>https://github.com/snxui/snxui</vendor_url>

  <action id="com.snxui.tun">
    <description>Create VPN TUN network interface</description>
    <description xml:lang="ru">Создать TUN-интерфейс для VPN</description>
    <message>Authentication required to create VPN network interface</message>
    <message xml:lang="ru">Для создания сетевого интерфейса VPN требуется аутентификация</message>
    <icon_name>network-vpn</icon_name>
    <defaults>
      <allow_any>auth_self</allow_any>
      <allow_inactive>auth_self</allow_inactive>
      <allow_active>auth_self_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/snxui/snxui-net-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>

</policyconfig>
